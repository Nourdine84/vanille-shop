{
  "compilerOptions": {
    /* =========================
        CORE CONFIG
     ========================= */
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",

    /* =========================
        STRICT MODE (PRO)
     ========================= */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,

    /* =========================
        CODE QUALITY
     ========================= */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* =========================
        MODULE & INTEROP
     ========================= */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* =========================
        NEXT / BUILD
     ========================= */
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,

    /* =========================
        TYPES
     ========================= */
    "types": ["node"],

    /* =========================
        IMPORT ALIAS (CRITICAL FIX)
     ========================= */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    /* =========================
        SAFETY
     ========================= */
    "allowJs": true,

    /* =========================
        NEXT PLUGIN
     ========================= */
    "plugins": [
      {
        "name": "next"
      }
    ]
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "scripts/**/*.js"
  ],

  "exclude": ["node_modules", ".next"]
}